{
  "schema": 1,
  "model": "aifs",
  "model_label": "ECMWF AIFS Single v2",
  "provider": "ECMWF Open Data",
  "resolution": "0.25° disseminated grid (~31 km native N320)",
  "runs_utc": [0, 6, 12, 18],
  "forecast_step_hours": 6,
  "horizon_hours": 360,
  "pressure_levels_hpa": [925, 850, 700, 500, 300, 250, 200],
